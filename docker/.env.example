# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ops_platform

# Redis
REDIS_PASSWORD=123456
REDIS_DB=0

# JWT signing key. Replace with a long, random, stable value before production.
SECRET_KEY=replace-with-a-long-random-value

# Initial administrator. Used only when the users table is empty on first startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# Public frontend port
FRONTEND_PORT=80

# The SSH terminal and SFTP file panel require ssh_terminal.connect.
ENABLE_SSH_TERMINAL=true
ENABLE_SFTP=true
ENABLE_BATCH_EXEC=false
ENABLE_DEPLOY_WEBHOOK=false
