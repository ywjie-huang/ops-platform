# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ops_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# 前端端口（默认 80）
FRONTEND_PORT=80

# 高风险入口开关（Docker/K8s 部署示例已启用 SSH 与 SFTP）
# 如无需远程终端或文件管理，可将对应变量设置为 false。
ENABLE_SSH_TERMINAL=true
ENABLE_SFTP=true
ENABLE_BATCH_EXEC=false
ENABLE_DEPLOY_WEBHOOK=false
